# Copy this file to .env and fill in real values. Never commit .env (it is in .gitignore).
# Real environment variables always win over values in .env.

# "development" enables debug output; ANYTHING else (including unset) is treated as production.
# Must be "production" on a deployed server.
APP_ENV=production
BASE_URL=http://localhost/sk-scholarship/public

DB_HOST=127.0.0.1
DB_NAME=sk_scholarship
DB_USER=root
DB_PASS=

# Outgoing mail (OTP codes, notifications, reminders). Requires `composer install` (PHPMailer).
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=your-email@example.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME="SK Scholarship"
MAIL_ENCRYPTION=ssl
