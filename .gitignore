.env
storage/logs/*
!storage/logs/.gitkeep

# Private applicant/scholar uploads — never commit personal documents
storage/documents/
storage/term-documents/

# Database dumps / backups contain personal data and password hashes — keep them OUTSIDE the project
# (e.g. C:\xampp\sk-scholarship-backups\). These patterns stop one from being committed by accident.
backup_*.sql
/*.sql
*.sql.gz

# Test tools (tests/composer.json) and PHPUnit cache: installed locally, never committed
tests/vendor/
tests/.phpunit.cache/

# Session files (private: who is signed in)
storage/sessions/
